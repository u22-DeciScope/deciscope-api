PORT=9090
DATABASE_URL=postgres://deciscope:deciscope@localhost:5432/deciscope?sslmode=disable
POSTGRES_DB=deciscope
POSTGRES_USER=deciscope
POSTGRES_PASSWORD=deciscope
POSTGRES_PORT=5432
