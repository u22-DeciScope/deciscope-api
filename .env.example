API_PORT=9090
POSTGRES_DB=deciscope
POSTGRES_USER=deciscope
POSTGRES_PASSWORD=change-me-change-me-change-me-1234
DATABASE_URL=postgres://deciscope:change-me-change-me-change-me-1234@localhost:5432/deciscope?sslmode=disable
DECISCOPE_INGEST_API_KEY=change-me-change-me-change-me-1234
DECISCOPE_TRANSCRIPT_STORE=postgres
DECISCOPE_TRANSCRIPT_ONLY=false
# 固定デモワークスペース (ws_demo_deciscope) を投入する旧式の開発用 seed。
# ログイン時の自動参加は廃止済みのため、閲覧するには手動で workspace_members への追加が必要。
# 通常の初回ログインフロー確認では false のままにしてください。
DECISCOPE_SEED_DEMO_DATA=false

# 初回作成ワークスペースにサンプル会議 (文字起こし・議論ツリー・分析カード付き) を投入するか。
# 未設定なら DECISCOPE_ENV=development で true、production で false。
DECISCOPE_CREATE_SAMPLE_MEETING_ON_FIRST_WORKSPACE=true
DECISCOPE_WS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,http://localhost:5193,http://127.0.0.1:5193
DECISCOPE_BOT_CONTROL_URL=http://<Azure_VMのTailscale_IP>:<Bot制御APIのport>/internal/bot/join
DECISCOPE_BOT_CONTROL_TOKEN=change-me-bot-control-token
DECISCOPE_BOT_CONTROL_TIMEOUT_SECONDS=10
# Teams会議名解決用。Entra object id を推奨。UPN/email は Bot 側で /users/{upn} 解決してから使います。
MEETING_TITLE_LOOKUP_USER_IDS=
# DECISCOPE_BACKEND_ADDR=100.70.221.61:9090
UPLOAD_DIR=./uploads
FRONTEND_URL=http://localhost:5193
ALLOWED_ORIGINS=http://localhost:5193
SESSION_COOKIE_SECURE=false

# 環境種別。development (既定) ではSMTP未設定時に招待URLをログ出力する dev fallback が有効。
# production ではSMTP未設定のまま招待を作成できません。
DECISCOPE_ENV=development
# ワークスペース招待メールのSMTP設定 (任意。未設定なら上記 fallback 動作)。
DECISCOPE_SMTP_HOST=
DECISCOPE_SMTP_PORT=587
DECISCOPE_SMTP_USERNAME=
DECISCOPE_SMTP_PASSWORD=
DECISCOPE_SMTP_FROM=

# Enable Firebase Admin SDK token verification.
AUTH_PROVIDER=firebase
FIREBASE_PROJECT_ID=your-project-id

# Choose one of the following credential styles.
FIREBASE_SERVICE_ACCOUNT_JSON=./serviceAccountKey.json
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# AI会議分析(Azure OpenAI)。ENDPOINT/API_KEY/DEPLOYMENTのいずれかが未設定の場合、
# AI機能全体が自動的に無効化されます(transcript機能や会議終了処理には影響しません)。
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=replace-me
AZURE_OPENAI_DEPLOYMENT=your-chat-deployment-name
AZURE_OPENAI_API_VERSION=2024-10-21
AI_LIVE_ANALYSIS_ENABLED=true
AI_LIVE_ANALYSIS_INTERVAL_SECONDS=10
AI_LIVE_ANALYSIS_MIN_CHARS=80
AI_LIVE_ANALYSIS_MAX_INPUT_CHARS=4000
AI_FINAL_SUMMARY_ENABLED=true
AI_FINAL_SUMMARY_MAX_INPUT_CHARS=12000
AI_REQUEST_TIMEOUT_SECONDS=20
AI_FINAL_SUMMARY_TIMEOUT_SECONDS=60
# 破棄されたツリーノードの詳細(id/kind/title/reason)を開発用にログ出力する。既定: false
AI_ANALYSIS_DEBUG_DROPPED_NODES=false

# 文字起こしヘルス監視(Botの生死とは別軸で、文字起こしが止まっていないかを検知)。
# 最後のtranscript受信からの経過秒数がこの値以上で transcript_delayed を通知。既定: 30, 最小: 5
DECISCOPE_TRANSCRIPT_DELAYED_AFTER_SECONDS=30
# 上記経過秒数がこの値以上で transcript_stalled を通知。既定: 60 (DELAYED_AFTER以下の値は自動補正)
DECISCOPE_TRANSCRIPT_STALLED_AFTER_SECONDS=60

# 文字起こしギャップが発生した際、Botから送られる音声メトリクス(heartbeatボディ)が
# 新鮮であれば silent/audio_stalled/speech_stalled に細分類する。メトリクス未着・古い場合は
# 上記 transcript_delayed/transcript_stalled にそのまま縮退する。
# 直近non-zero音声からの経過秒数がこの値以上で「無音(silent)」の候補。既定: 30, 最小: 5
DECISCOPE_AUDIO_SILENCE_AFTER_SECONDS=30
# 直近音声フレーム受信からの経過秒数がこの値以上、または受信スタール通知があると「音声停止(audio_stalled)」。既定: 60, 最小: 5
DECISCOPE_AUDIO_STALLED_AFTER_SECONDS=60
# 音声はあるのに直近non-empty transcriptからの経過秒数がこの値以上だと「発話認識停止(speech_stalled)」。既定: 60, 最小: 5
DECISCOPE_SPEECH_STALLED_AFTER_SECONDS=60
