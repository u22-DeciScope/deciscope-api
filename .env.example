API_PORT=9090
POSTGRES_DB=deciscope
POSTGRES_USER=deciscope
POSTGRES_PASSWORD=change-me-change-me-change-me-1234
DATABASE_URL=postgres://deciscope:change-me-change-me-change-me-1234@localhost:5432/deciscope?sslmode=disable
DECISCOPE_INGEST_API_KEY=change-me-change-me-change-me-1234
DECISCOPE_TRANSCRIPT_ONLY=false

# 初回作成ワークスペースにサンプル会議 (文字起こし・議論ツリー・分析カード付き) を投入するか。
# 未設定なら DECISCOPE_ENV=development で true、production で false。
DECISCOPE_CREATE_SAMPLE_MEETING_ON_FIRST_WORKSPACE=true
DECISCOPE_WS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,http://localhost:5193,http://127.0.0.1:5193
DECISCOPE_BOT_CONTROL_URL=http://<Azure_VMのTailscale_IP>:<Bot制御APIのport>/internal/bot/join
DECISCOPE_BOT_CONTROL_TOKEN=change-me-bot-control-token
DECISCOPE_BOT_CONTROL_TIMEOUT_SECONDS=10
# DECISCOPE_BACKEND_ADDR=100.70.221.61:9090
FRONTEND_URL=http://localhost:5193
ALLOWED_ORIGINS=http://localhost:5193
SESSION_COOKIE_SECURE=false

# 環境種別。development (既定) では招待URLをログ出力する dev fallback が有効。
# production では招待リンクの通知基盤がないため招待を作成できません。
DECISCOPE_ENV=development

# Enable Firebase Admin SDK token verification.
AUTH_PROVIDER=firebase
FIREBASE_PROJECT_ID=your-project-id

# Choose one of the following credential styles.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# AI会議分析(Azure OpenAI)。ENDPOINT/API_KEY/DEPLOYMENTのいずれかが未設定の場合、
# AI機能全体が自動的に無効化されます(transcript機能や会議終了処理には影響しません)。
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=replace-me
AZURE_OPENAI_DEPLOYMENT=your-chat-deployment-name
AZURE_OPENAI_API_VERSION=2024-10-21
# タスク別deployment。未設定のtaskはAZURE_OPENAI_DEPLOYMENTへfallbackします。
AZURE_OPENAI_LIVE_EXTRACTION_DEPLOYMENT=ds-live-analysis-gpt-5-nano
AZURE_OPENAI_CONTEXT_PLANNER_DEPLOYMENT=
AZURE_OPENAI_TREE_AUDIT_DEPLOYMENT=ds-tree-auditor-gpt-5-mini
AZURE_OPENAI_TREE_REORGANIZER_DEPLOYMENT=ds-tree-auditor-gpt-5-mini
AZURE_OPENAI_FINAL_TREE_REVIEW_DEPLOYMENT=ds-tree-auditor-gpt-5-mini
AZURE_OPENAI_FINAL_SUMMARY_DEPLOYMENT=ds-tree-auditor-gpt-5-mini
AI_LIVE_ANALYSIS_ENABLED=true
AI_LIVE_ANALYSIS_INTERVAL_SECONDS=10
AI_LIVE_ANALYSIS_DEBOUNCE_MILLISECONDS=2000
AI_LIVE_ANALYSIS_COOLDOWN_SECONDS=8
AI_LIVE_ANALYSIS_MAX_WAIT_SECONDS=18
AI_LIVE_ANALYSIS_MIN_CHARS=80
AI_LIVE_ANALYSIS_MAX_INPUT_CHARS=4000
AI_FINAL_SUMMARY_ENABLED=true
AI_FINAL_SUMMARY_MAX_INPUT_CHARS=12000
AI_REQUEST_TIMEOUT_SECONDS=20
AI_FINAL_SUMMARY_TIMEOUT_SECONDS=60
AI_FINALIZATION_WAIT_TIMEOUT_SECONDS=10
AI_FINALIZATION_QUIET_PERIOD_MILLISECONDS=750
AI_FINAL_FLUSH_MAX_ATTEMPTS=3
# 破棄されたツリーノードの詳細(id/kind/title/reason)を開発用にログ出力する。既定: false
AI_ANALYSIS_DEBUG_DROPPED_NODES=false

# 議論ツリー監査。高信頼かつvalidatorを通過した安全なoperationだけを通常適用します。
TREE_AUDIT_ENABLED=true
TREE_AUDIT_INTERVAL_VERSIONS=3
TREE_AUDIT_INTERVAL_SECONDS=60
TREE_AUDIT_MIN_INTERVAL_SECONDS=60
TREE_AUDIT_MAX_RUNS_PER_SESSION=20
TREE_AUDIT_MAX_RUNS_PER_HOUR=12
TREE_AUDIT_HIGH_SEVERITY_MIN_INTERVAL_SECONDS=60
TREE_AUDIT_HIGH_SEVERITY_MAX_RUNS_PER_HOUR=4
TREE_AUDIT_TIMEOUT_SECONDS=25
TREE_AUDIT_MAX_OUTPUT_TOKENS=2500
TREE_AUDIT_MAX_NODES=80
TREE_AUDIT_MAX_RECENT_SEGMENTS=16
TREE_AUDIT_MAX_EVIDENCE_SEGMENTS=24
TREE_AUDIT_MAX_INPUT_TOKENS=12000
TREE_AUDIT_MAX_PERSISTED_JSON_BYTES=262144
TREE_AUDIT_HIGH_CONFIDENCE_THRESHOLD=0.90
TREE_AUDIT_REQUIRED_IMPROVEMENT_MARGIN=0.18
TREE_AUDIT_COHESION_THRESHOLD=0.20
TREE_AUDIT_TENTATIVE_MAX_VERSIONS=3
TREE_AUDIT_UNAPPLIED_WARNING_THRESHOLD=3

# 文字起こしヘルス監視(Botの生死とは別軸で、文字起こしが止まっていないかを検知)。
# 最後のtranscript受信からの経過秒数がこの値以上で transcript_delayed を通知。既定: 30, 最小: 5
DECISCOPE_TRANSCRIPT_DELAYED_AFTER_SECONDS=30
# 上記経過秒数がこの値以上で transcript_stalled を通知。既定: 60 (DELAYED_AFTER以下の値は自動補正)
DECISCOPE_TRANSCRIPT_STALLED_AFTER_SECONDS=60

# 文字起こしギャップが発生した際、Botから送られる音声メトリクス(heartbeatボディ)が
# 新鮮であれば silent/audio_stalled/speech_stalled に細分類する。メトリクス未着・古い場合は
# 上記 transcript_delayed/transcript_stalled にそのまま縮退する。
# 直近non-zero音声からの経過秒数がこの値以上で「無音(silent)」の候補。既定: 30, 最小: 5
DECISCOPE_AUDIO_SILENCE_AFTER_SECONDS=30
# 直近音声フレーム受信からの経過秒数がこの値以上、または受信スタール通知があると「音声停止(audio_stalled)」。既定: 60, 最小: 5
DECISCOPE_AUDIO_STALLED_AFTER_SECONDS=60
# 音声はあるのに直近non-empty transcriptからの経過秒数がこの値以上だと「発話認識停止(speech_stalled)」。既定: 60, 最小: 5
DECISCOPE_SPEECH_STALLED_AFTER_SECONDS=60

# クライアント診断ログ(会議画面の議論ツリー消失をブラウザのコンソールに依存せず追跡する)。
# ブラウザからの POST /internal/client-diagnostics を受け、標準ログと
# {DIR}/{sessionId}.jsonl の両方へ出力する。認証必須・ワークスペース/セッション認可あり。
DECISCOPE_CLIENT_DIAGNOSTICS_ENABLED=true
# JSONLの保存先。Docker利用時は compose.yaml でホスト側へ volume mount している。
DECISCOPE_CLIENT_DIAGNOSTICS_DIR=logs/client-diagnostics
# 1ファイルがこのサイズを超えたら {sessionId}.jsonl.1 へ退避して書き直す。既定: 10 (MB)
DECISCOPE_CLIENT_DIAGNOSTICS_MAX_FILE_MB=10
# この日数より古い診断ログファイルは削除する。既定: 7 (日)
DECISCOPE_CLIENT_DIAGNOSTICS_RETENTION_DAYS=7
# 1リクエストで受理する診断イベント数の上限。超過分は拒否する。既定: 100
DECISCOPE_CLIENT_DIAGNOSTICS_MAX_EVENTS_PER_REQUEST=100
# 同一内容の高頻度イベントを抑制する時間窓(ミリ秒)。0で抑制なし。
# tree_became_empty と react_error_captured は抑制対象外。既定: 1000
DECISCOPE_CLIENT_DIAGNOSTICS_THROTTLE_MS=1000
