# Enable Firebase Admin SDK token verification.
AUTH_PROVIDER=firebase
FIREBASE_PROJECT_ID=your-project-id

# Choose one of the following credential styles.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
